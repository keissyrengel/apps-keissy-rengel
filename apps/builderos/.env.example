# Copy to .env.local for local development. Never commit .env.local.
#
# In production these are set on the Cloudflare Worker:
#   secrets -> npx wrangler secret put <NAME>
#   vars    -> wrangler.jsonc

# Required. OpenAI API key used to generate apps.
OPENAI_API_KEY=

# Optional. Any chat-completions capable model id.
OPENAI_MODEL=gpt-5.6-terra

# Required to publish. GitHub fine-grained token with
# "Contents: read and write" on the target repository.
GITHUB_TOKEN=

# Where published apps are committed.
GITHUB_OWNER=keissyrengel
GITHUB_REPO=apps-keissy-rengel
GITHUB_BRANCH=main
PUBLISH_DIRECTORY=apps
PUBLIC_BASE_URL=https://apps.keissyrengel.com

# Strongly recommended in production: shared code required to call
# /api/build and /api/publish. Leave empty to disable the gate locally.
BUILDER_ACCESS_CODE=

# Optional. Override the OpenAI-compatible API base URL (used by tests).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Override the GitHub API base URL (used by tests).
# GITHUB_API_URL=https://api.github.com

# Credit appended to the footer of every generated app.
# Leave CREDIT_TEXT and CREDIT_LINK_TEXT empty to disable it.
CREDIT_TEXT=Esta app fue hecha con 💜 por
CREDIT_LINK_TEXT=Konvertis Agency
CREDIT_URL=https://www.konvertisagency.com
