# Runtime selection. Local uses the current filesystem/Codex pipeline.
# Remote is a controlled stub until Cloudflare Sandbox is connected.
BUILDER_RUNTIME=local
SANDBOX_TRANSPORT=rpc

# Real Codex App Server engine is the default. Set local for template fallback.
BUILDER_ENGINE=codex

# Optional: omit this to use the model configured by Codex.
# CODEX_MODEL=
