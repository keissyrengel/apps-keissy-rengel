{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "builderos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["Sandbox"]
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "GITHUB_OWNER": "keissyrengel",
    "GITHUB_REPO": "apps-keissy-rengel",
    "GITHUB_BRANCH": "main",
    "PUBLISH_DIRECTORY": "apps",
    "PUBLIC_BASE_URL": "https://apps.keissyrengel.com",
    "CREDIT_TEXT": "Esta app fue hecha con \ud83d\udc9c por",
    "CREDIT_LINK_TEXT": "Konvertis Agency",
    "CREDIT_URL": "https://www.konvertisagency.com"
  }
}
