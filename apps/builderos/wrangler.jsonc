{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "builderos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Non-secret configuration. Secrets (OPENAI_API_KEY, GITHUB_TOKEN,
  // BUILDER_ACCESS_CODE) are set with `npx wrangler secret put <NAME>` and must
  // never be added here.
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "GITHUB_OWNER": "keissyrengel",
    "GITHUB_REPO": "apps-keissy-rengel",
    "GITHUB_BRANCH": "main",
    "PUBLISH_DIRECTORY": "apps",
    "PUBLIC_BASE_URL": "https://apps.keissyrengel.com"
  }
}
