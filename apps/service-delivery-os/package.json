{
  "name": "service-delivery-os",
  "private": true,
  "scripts": {
    "assets": "mkdir -p dist && cp index.html dist/index.html",
    "predev": "npm run assets",
    "dev": "wrangler dev",
    "predeploy": "npm run assets",
    "deploy": "wrangler deploy",
    "predry-run": "npm run assets",
    "dry-run": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply service-delivery-os --local",
    "db:migrate:remote": "wrangler d1 migrations apply service-delivery-os --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.124.0"
  }
}
