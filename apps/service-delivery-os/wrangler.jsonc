{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "service-delivery-os",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "service-delivery-os",
      "database_id": "2628df7c-1912-4199-afea-6ef7baef1e42",
      "migrations_dir": "migrations"
    }
  ]
}
